/* =====================================================
   VESTORA — PREMIUM DASHBOARD DESIGN
   Dark luxury interface | Responsive | Gold accents
   ===================================================== */

:ro2
ot {
  --v-bg: #080b13;
  --v-surface: #101622;
  --v-surface-2: #151e2d;
  --v-surface-3: #1a2535;
  --v-border: rgba(255,255,255,.075);
  --v-gold: #d6b15c;
  --v-gold-light: #f0d58d;
  --v-text: #f4f5f8;
  --v-muted: #8c98aa;
  --v-green: #20c997;
  --v-red: #f06a78;
  --v-radius: 16px;
}

body {
  background: var(--v-bg) !important;
  color: var(--v-text);
  font-family: 'DM Sans', sans-serif;
}

.glow {
  opacity: .12;
  filter: blur(100px);
  pointer-events: none;
}

/* MAIN APP LAYOUT */

.app {
  background: var(--v-bg);
  min-height: 100vh;
}

.app > aside {
  background: #0c111c !important;
  border-right: 1px solid var(--v-border);
  padding: 28px 18px !important;
}

.brand {
  color: #fff !important;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 21px !important;
  font-weight: 700;
  letter-spacing: 2px;
}

.brand b {
  color: var(--v-gold) !important;
}

.sidehead {
  color: #66748a !important;
  letter-spacing: 2px;
  font-size: 9px !important;
  font-weight: 700;
  margin-top: 45px;
}

.app aside nav {
  margin-top: 15px;
  display: grid;
  gap: 8px;
}

.app aside nav button {
  width: 100%;
  text-align: left;
  padding: 14px 13px !important;
  border: 1px solid transparent !important;
  border-radius: 10px !important;
  background: transparent !important;
  color: #9ca8ba !important;
  font-size: 12px !important;
  transition: .2s ease;
}

.app aside nav button:hover {
  background: #182131 !important;
  color: #fff !important;
}

.app aside nav button.active {
  background: linear-gradient(100deg,#d6b15c20,#d6b15c08) !important;
  border-color: #d6b15c45 !important;
  color: var(--v-gold-light) !important;
}

/* MAIN WORKSPACE */

.work {
  background: var(--v-bg) !important;
}

.work > header {
  min-height: 86px;
  background: rgba(12,17,28,.94) !important;
  border-bottom: 1px solid var(--v-border);
  padding: 18px 30px !important;
  backdrop-filter: blur(15px);
}

.work > header small {
  color: var(--v-muted) !important;
  letter-spacing: 1.5px;
  font-size: 9px !important;
}

.work > header h2 {
  color: #fff !important;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 23px !important;
  margin-top: 5px;
}

#avatar {
  background: linear-gradient(145deg,#f0d58d,#a77b2d) !important;
  color: #17130b !important;
  font-weight: 800;
  border: 2px solid #f0d58d66;
}

.header-logout {
  border: 1px solid var(--v-border) !important;
  background: #151e2d !important;
  color: #d5dbe5 !important;
  border-radius: 9px !important;
  padding: 10px 15px !important;
}

.content {
  padding: 30px !important;
  max-width: 1600px;
  margin: auto;
}

.page > h1,
.page h1 {
  color: #fff;
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -.8px;
}

.page > small {
  color: var(--v-gold);
  letter-spacing: 2px;
  font-weight: 700;
}

/* WELCOME AREA */

.welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.welcome h1 {
  font-size: clamp(25px,3vw,34px);
  margin: 0 0 8px;
}

.welcome h1 span {
  color: var(--v-gold-light);
}

.welcome p,
.page p {
  color: var(--v-muted);
}

#date {
  color: var(--v-muted);
  font-size: 11px;
}

/* VST FEATURE CARD */

.vst-promo {
  border-radius: 20px !important;
  border: 1px solid #d6b15c55 !important;
  box-shadow: 0 18px 55px #0006;
}

/* NOTICE CARDS */

.notice {
  background: linear-gradient(120deg,#151f2e,#101724) !important;
  border: 1px solid var(--v-border) !important;
  border-left: 3px solid var(--v-gold) !important;
  border-radius: 12px !important;
  padding: 19px 21px !important;
  margin: 18px 0 !important;
}

.notice b {
  color: #f2d58d;
  font-size: 13px;
}

.notice p {
  color: #a6b1c1 !important;
  font-size: 11px;
  line-height: 1.8;
}

/* ACCOUNT STATISTICS */

.stats {
  display: grid !important;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px !important;
  margin: 25px 0 32px !important;
}

.stats article {
  background: linear-gradient(145deg,#151e2d,#101622) !important;
  border: 1px solid var(--v-border) !important;
  border-radius: var(--v-radius) !important;
  padding: 23px !important;
  min-width: 0;
  transition: .2s ease;
}

.stats article:hover {
  border-color: #d6b15c55 !important;
  transform: translateY(-2px);
}

.stats article.featured {
  background: linear-gradient(135deg,#292316,#151b27) !important;
  border-color: #d6b15c66 !important;
}

.stats article small {
  color: var(--v-muted) !important;
  letter-spacing: 1.2px;
  font-size: 9px !important;
}

.stats article h2 {
  color: #fff !important;
  font-family: 'Space Grotesk',sans-serif;
  font-size: clamp(21px,3vw,29px) !important;
  margin: 13px 0 7px;
  overflow-wrap: anywhere;
}

.stats article.featured h2 {
  color: var(--v-gold-light) !important;
}

.stats article p {
  color: #8996a9 !important;
  font-size: 10px !important;
}

/* QUICK ACCESS */

.quick {
  display: grid !important;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 15px !important;
  margin-top: 18px;
}

.quick button {
  background: #121b29 !important;
  border: 1px solid var(--v-border) !important;
  border-radius: 13px !important;
  padding: 22px !important;
  color: var(--v-gold-light) !important;
  text-align: left;
  font-size: 20px;
  transition: .2s ease;
}

.quick button:hover {
  background: #1b2637 !important;
  border-color: #d6b15c66 !important;
  transform: translateY(-3px);
}

.quick button b {
  display: block;
  color: #fff !important;
  font-size: 12px;
  margin: 13px 0 6px;
}

.quick button small {
  display: block;
  color: var(--v-muted) !important;
  font-size: 10px;
}

/* GENERAL PANELS */

.panel,
.table,
.wallet {
  background: linear-gradient(145deg,#151e2d,#101622) !important;
  border: 1px solid var(--v-border) !important;
  border-radius: var(--v-radius) !important;
  padding: 23px !important;
  margin: 20px 0 !important;
  box-shadow: 0 12px 35px #0002;
}

.panel h3,
.table h3 {
  color: #fff !important;
  font-size: 15px;
  margin-bottom: 18px;
}

.wallet {
  background: linear-gradient(120deg,#292316,#151b27) !important;
  border-color: #d6b15c66 !important;
}

.wallet small {
  color: var(--v-gold-light) !important;
  letter-spacing: 1.5px;
}

.wallet h2 {
  color: #fff !important;
  font-family: 'Space Grotesk',sans-serif;
  font-size: 35px;
  margin: 13px 0;
}

.pill {
  color: var(--v-gold-light) !important;
  border: 1px solid #d6b15c66 !important;
  background: #d6b15c14 !important;
  border-radius: 30px;
  padding: 7px 12px;
  font-size: 9px;
}

/* INPUTS AND FORMS */

label {
  color: #aeb9c9 !important;
  font-size: 11px !important;
  font-weight: 600;
}

input,
select,
textarea {
  background: #0b111c !important;
  color: #fff !important;
  border: 1px solid #293548 !important;
  border-radius: 9px !important;
  padding: 13px !important;
  outline: none !important;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--v-gold) !important;
  box-shadow: 0 0 0 3px #d6b15c18 !important;
}

input::placeholder {
  color: #657287 !important;
}

/* BUTTONS */

.primary,
button.primary {
  background: linear-gradient(110deg,#bd913e,#ecd18a) !important;
  color: #17130b !important;
  border: none !important;
  border-radius: 9px !important;
  font-weight: 800 !important;
  padding: 13px 18px !important;
  transition: .2s ease;
}

.primary:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.secondary,
.copy,
.admin-back-button {
  background: #1a2535 !important;
  color: #dce3ec !important;
  border: 1px solid #344257 !important;
  border-radius: 9px !important;
  padding: 11px 15px !important;
}

button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

/* TABLES */

.table {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 650px;
}

th {
  color: #8996a9 !important;
  font-size: 9px !important;
  letter-spacing: 1px;
  font-weight: 700;
  text-align: left;
  padding: 14px 12px !important;
  background: #0c1420 !important;
}

td {
  color: #d9e0e9 !important;
  font-size: 11px !important;
  padding: 15px 12px !important;
  border-bottom: 1px solid var(--v-border) !important;
}

tr:hover td {
  background: #ffffff05;
}

/* DEPOSIT ADDRESSES */

.address {
  background: #0b111c !important;
  border: 1px solid #28364a !important;
  border-radius: 11px !important;
  padding: 17px !important;
  margin: 13px 0;
}

.address b {
  display: block;
  color: var(--v-gold-light);
  font-size: 11px;
  margin-bottom: 12px;
}

.address code {
  display: block;
  color: #c2ccda;
  overflow-wrap: anywhere;
  font-size: 10px;
  line-height: 1.8;
  margin-bottom: 12px;
}

/* ADMIN DASHBOARD */

.admin-dashboard-intro {
  color: var(--v-muted);
  font-size: 12px;
}

.admin-dashboard-grid {
  display: grid !important;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px !important;
  margin-top: 25px;
}

.admin-dashboard-card {
  display: flex !important;
  align-items: center;
  gap: 14px;
  text-align: left;
  min-width: 0;
  padding: 22px !important;
  background: linear-gradient(145deg,#182334,#101722) !important;
  border: 1px solid #29384b !important;
  border-radius: 15px !important;
  color: #fff !important;
  transition: .2s ease;
}

.admin-dashboard-card:hover {
  border-color: var(--v-gold) !important;
  transform: translateY(-3px);
  box-shadow: 0 15px 35px #0004;
}

.admin-card-icon {
  flex: 0 0 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: #d6b15c18;
  color: var(--v-gold-light);
  border: 1px solid #d6b15c44;
  border-radius: 12px;
  font-size: 20px;
}

.admin-card-copy {
  flex: 1;
  min-width: 0;
}

.admin-card-copy strong {
  display: block;
  font-size: 12px;
  color: #fff;
}

.admin-card-copy small {
  display: block;
  color: var(--v-muted);
  font-size: 10px;
  line-height: 1.6;
  margin-top: 6px;
}

.admin-card-arrow {
  color: var(--v-gold);
}

.admin-subview {
  margin-top: 20px;
}

.admin-back-button {
  margin-bottom: 25px;
}

.balance-customer-balances {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12px;
  margin: 20px 0;
}

.balance-customer-balances > div {
  background: #0b111c;
  border: 1px solid var(--v-border);
  border-radius: 10px;
  padding: 17px;
}

.balance-customer-balances small {
  display: block;
  color: var(--v-muted);
  font-size: 9px;
  margin-bottom: 9px;
}

.balance-customer-balances strong {
  color: var(--v-gold-light);
  font-size: 19px;
}

/* FOOTER */

.appfooter {
  color: #647187 !important;
  border-top: 1px solid var(--v-border);
  padding: 20px 30px !important;
  font-size: 10px;
  text-align: center;
}

/* RESPONSIVE TABLET */

@media(max-width:1050px) {
  .content {
    padding: 22px !important;
  }

  .admin-dashboard-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

/* RESPONSIVE MOBILE */

@media(max-width:700px) {
  .content {
    padding: 16px !important;
  }

  .work > header {
    padding: 15px !important;
  }

  .work > header h2 {
    font-size: 19px !important;
  }

  .stats {
    grid-template-columns: 1fr !important;
    gap: 11px !important;
  }

  .stats article {
    padding: 18px !important;
  }

  .quick {
    grid-template-columns: 1fr !important;
  }

  .admin-dashboard-grid {
    grid-template-columns: 1fr !important;
  }

  .welcome {
    align-items: flex-start;
    flex-direction: column;
  }

  .balance-customer-balances {
    grid-template-columns: 1fr;
  }

  .panel,
  .table {
    padding: 16px !important;
  }

  .appfooter {
    padding: 17px !important;
  }
}

@media(prefers-reduced-motion:reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
